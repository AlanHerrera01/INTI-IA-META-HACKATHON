# Copy to .env. Never commit credentials. JSON syntax is required for lists.
DATABASE_URL=postgresql+psycopg://inti:inti@127.0.0.1:5432/inti?connect_timeout=5
ARTIFACT_DIR=artifacts
DEMO_URL=http://127.0.0.1:8001/
BROWSER_ALLOWED_URLS=["http://127.0.0.1:8001/"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
META_API_KEY=
META_MODEL_ID=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1
META_REQUEST_TIMEOUT_SECONDS=60
POSTGRES_PASSWORD=inti
PLANNING_MAX_STEPS=20
PLANNING_MAX_RETRIES=2
PLANNING_MAX_TOKENS=4096
PLANNING_TIMEOUT_SECONDS=120
PLANNING_TTL_SECONDS=900
PLANNING_MIN_CONFIDENCE=0.6
META_MAX_RESPONSE_BYTES=262144
EXECUTION_ENABLED=false
# Generate separate random tokens (at least 24 characters). Never commit real values.
EXECUTION_OPERATOR_TOKEN=
BROWSER_WORKER_TOKEN=
BROWSER_WORKER_URL=http://127.0.0.1:8010
EXECUTION_MAX_ACTIONS=30
EXECUTION_MAX_DURATION_SECONDS=180
EXECUTION_ACTION_TIMEOUT_SECONDS=10
EXECUTION_MAX_CONCURRENT_SESSIONS=2
EXECUTION_MAX_NAVIGATION_COUNT=3
EXECUTION_OBSERVATION_MAX_AGE_SECONDS=5
BROWSER_SESSION_TTL_SECONDS=180
MAX_ARTIFACT_BYTES=5000000

# Independent read-only evidence gateway (separate random capability).
VERIFICATION_ENABLED=false
VERIFICATION_AUTO_TRIGGER=true
VERIFICATION_READONLY_URL=http://127.0.0.1:8003/
VERIFICATION_READ_TOKEN=
VERIFICATION_TIMEOUT_SECONDS=30
VERIFICATION_SOURCE_TIMEOUT_SECONDS=3
VERIFICATION_SOURCE_RETRIES=1
VERIFICATION_EVIDENCE_MAX_AGE_SECONDS=30
VERIFICATION_MAX_RESPONSE_BYTES=500000
RECOVERY_ENABLED=false
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_MAX_DURATION_SECONDS=120
RECOVERY_MAX_MODEL_CALLS=5
RECOVERY_MAX_ACTIONS=10
RECOVERY_MAX_TOKENS=
RECOVERY_MAX_IDENTICAL_FAILURES=2
# Optional private fault administration. Empty disables it; never share with agent.
DEMO_FAULT_CONTROL_TOKEN=
