ARTIFACT_DIR=artifacts
DEMO_URL=http://127.0.0.1:8001/
BROWSER_ALLOWED_URLS=["http://127.0.0.1:8001/"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
META_API_KEY=
META_MODEL_ID=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1
META_REQUEST_TIMEOUT_SECONDS=60
POSTGRES_PASSWORD=inti
PLANNING_MAX_STEPS=20
PLANNING_MAX_RETRIES=2
PLANNING_MAX_TOKENS=4096
PLANNING_TIMEOUT_SECONDS=120
PLANNING_TTL_SECONDS=900
PLANNING_MIN_CONFIDENCE=0.6
META_MAX_RESPONSE_BYTES=262144
EXECUTION_ENABLED=false
# Generate separate random tokens (at least 24 characters). Never commit real values.
