# INTI AI - Configuracion local
# Copia este archivo a .env. No compartas credenciales.

# 1. Ejecucion: agente Windows conectado al dashboard
INTI_RUNTIME_MODE=local_computer

# 2. Acceso y base de datos
# start_computer.ps1 genera el token si esta vacio.
EXECUTION_OPERATOR_TOKEN=
POSTGRES_PASSWORD=inti

# 3. Meta (opcional; no requiere clave para las tareas locales actuales)
# Docker mantiene las llamadas reales desactivadas.
MISSION_MODEL_CALLS_ENABLED=false
META_API_KEY=
META_MODEL_ID=muse-spark-1.3
