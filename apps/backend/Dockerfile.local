FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
RUN --mount=type=secret,id=build_ca,required=false \
    cp /etc/ssl/certs/ca-certificates.crt /tmp/inti-build-ca.pem && \
    if [ -f /run/secrets/build_ca ]; then cat /run/secrets/build_ca >> /tmp/inti-build-ca.pem; fi && \
    PIP_CERT=/tmp/inti-build-ca.pem python -c "import subprocess,tomllib; subprocess.check_call(['pip','install','--no-cache-dir',*tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']])" && \
    rm /tmp/inti-build-ca.pem && useradd -m inti && mkdir /app/artifacts && chown inti:inti /app/artifacts
COPY src ./src
RUN --mount=type=secret,id=build_ca,required=false \
    cp /etc/ssl/certs/ca-certificates.crt /tmp/inti-build-ca.pem && \
    if [ -f /run/secrets/build_ca ]; then cat /run/secrets/build_ca >> /tmp/inti-build-ca.pem; fi && \
    PIP_CERT=/tmp/inti-build-ca.pem pip install --no-cache-dir --no-deps . && rm /tmp/inti-build-ca.pem
COPY alembic.ini ./
COPY migrations ./migrations
USER inti
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn inti.main:app --host 0.0.0.0 --port 8000"]
